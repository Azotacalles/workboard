DJANGO_SETTINGS_MODULE=config.settings.dev

# Только локальная разработка; для production эта заглушка не подходит.
SECRET_KEY=local-development-only-change-me

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True

# Django в контейнере подключается к db:5432.
DATABASE_URL=postgres://workboard:workboard_dev@db:5432/workboard

# Эти данные должны совпадать с DATABASE_URL.
POSTGRES_DB=workboard
POSTGRES_USER=workboard
POSTGRES_PASSWORD=workboard_dev

# FRONTEND
FRONTEND_URL=http://localhost:5173

# Gmail: пароль приложения без пробелов. Не коммитить настоящий пароль.
# SMTP username и адрес отправителя пока заданы в Python; см. README «Почта».
# Для console backend пароль не нужен, но нужно переключить MAILERS в настройках.
SMTP_PASSWORD=
